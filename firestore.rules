rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberOf(familyId) {
      return signedIn()
        && familyId is string
        && familyId.size() > 0
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function adminOf(familyId) {
      return memberOf(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function profileOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/profile/main).data;
    }

    function adminOfUserFamily(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/profile/main)
        && profileOf(userId).familyId is string
        && profileOf(userId).familyId.size() > 0
        && adminOf(profileOf(userId).familyId);
    }

    match /users/{userId}/profile/{profileId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || adminOfUserFamily(userId)
      );

      allow create: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn() && (
        request.auth.uid == userId
        || (
          resource.data.familyId is string
          && resource.data.familyId.size() > 0
          && adminOf(resource.data.familyId)
          && request.resource.data.familyId == ''
          && request.resource.data.role == ''
        )
      );

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/state/{stateId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || adminOfUserFamily(userId)
      );
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/devices/{deviceId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read: if memberOf(familyId);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if adminOf(familyId);

      match /members/{userId} {
        allow read: if memberOf(familyId);

        allow create: if signedIn() && (
          (
            request.auth.uid == userId
            && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid
            && request.resource.data.role == 'admin'
          )
          ||
          (
            request.auth.uid == userId
            && request.resource.data.role == 'member'
            && request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode)).data.active == true
            && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
            && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode)).data.familyId == familyId
          )
          ||
          adminOf(familyId)
        );

        allow update: if signedIn() && (
          adminOf(familyId)
          ||
          (
            request.auth.uid == userId
            && request.resource.data.role == resource.data.role
          )
        );

        allow delete: if signedIn() && (
          adminOf(familyId)
          || request.auth.uid == userId
        );
      }
    }

    match /familyInvites/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && adminOf(request.resource.data.familyId);

      allow update, delete: if signedIn()
        && adminOf(resource.data.familyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
