rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(familyId, userId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(userId);
    }

    function memberOf(familyId) {
      return signedIn()
        && familyId is string
        && familyId.size() > 0
        && exists(memberPath(familyId, request.auth.uid))
        && (
          !('status' in get(memberPath(familyId, request.auth.uid)).data)
          || get(memberPath(familyId, request.auth.uid)).data.status == 'active'
        );
    }

    function familyOwner(familyId) {
      return signedIn()
        && familyId is string
        && familyId.size() > 0
        && exists(/databases/$(database)/documents/families/$(familyId))
        && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
    }

    function adminOf(familyId) {
      return familyOwner(familyId)
        || (
          memberOf(familyId)
          && get(memberPath(familyId, request.auth.uid)).data.role == 'admin'
        );
    }

    function profileOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/profile/main).data;
    }

    function adminOfUserFamily(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/profile/main)
        && profileOf(userId).familyId is string
        && profileOf(userId).familyId.size() > 0
        && exists(memberPath(profileOf(userId).familyId, userId))
        && (
          !('status' in get(memberPath(profileOf(userId).familyId, userId)).data)
          || get(memberPath(profileOf(userId).familyId, userId)).data.status == 'active'
        )
        && adminOf(profileOf(userId).familyId);
    }

    match /userDirectory/{emailHash} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId}/profile/{profileId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || adminOfUserFamily(userId)
      );

      allow create: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn() && (
        request.auth.uid == userId
        || (
          resource.data.familyId is string
          && resource.data.familyId.size() > 0
          && adminOf(resource.data.familyId)
          && (
            (
              request.resource.data.familyId == ''
              && request.resource.data.role == ''
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId', 'role', 'updatedAt'])
            )
            ||
            (
              request.resource.data.familyId == resource.data.familyId
              && request.resource.data.role in ['member', 'admin']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
            )
          )
        )
      );

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/state/{stateId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || adminOfUserFamily(userId)
      );
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/data/{sectionId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || adminOfUserFamily(userId)
      );
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/devices/{deviceId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /families/{familyId} {
      allow read: if memberOf(familyId) || familyOwner(familyId);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if adminOf(familyId);

      match /members/{userId} {
        allow read: if signedIn() && (
          adminOf(familyId)
          || request.auth.uid == userId
          || (
            memberOf(familyId)
            && (
              !('status' in resource.data)
              || resource.data.status == 'active'
            )
          )
        );

        allow create: if signedIn() && (
          (
            request.auth.uid == userId
            && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
          )
          ||
          (
            adminOf(familyId)
            && request.resource.data.uid == userId
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'pending'
          )
        );

        allow update: if signedIn() && (
          adminOf(familyId)
          ||
          (
            request.auth.uid == userId
            && resource.data.uid == userId
            && request.resource.data.uid == userId
            && request.resource.data.role == resource.data.role
            && (
              (
                resource.data.status == 'pending'
                && request.resource.data.status in ['active', 'declined']
              )
              ||
              (
                resource.data.status == 'active'
                && request.resource.data.status == 'active'
              )
            )
          )
        );

        allow delete: if signedIn() && (
          adminOf(familyId)
          || request.auth.uid == userId
        );
      }
      
      match /shoppingLists/{listId} {
        allow read: if memberOf(familyId);

        allow create: if memberOf(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if memberOf(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.createdBy == resource.data.createdBy;

        allow delete: if adminOf(familyId)
          || (
            memberOf(familyId)
            && resource.data.createdBy == request.auth.uid
          );

        match /items/{itemId} {
          allow read: if memberOf(familyId);

          allow create: if memberOf(familyId)
            && request.resource.data.createdBy == request.auth.uid;

          allow update: if memberOf(familyId)
            && request.resource.data.createdBy == resource.data.createdBy;

          allow delete: if memberOf(familyId);
        }
      }
    }

    match /familyRequests/{requestId} {
      allow get, list: if signedIn() && (
        resource.data.targetUid == request.auth.uid
        || adminOf(resource.data.familyId)
      );

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && adminOf(request.resource.data.familyId);

      allow update: if signedIn() && (
        (
          resource.data.targetUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.targetUid == resource.data.targetUid
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.status in ['accepted', 'declined']
        )
        ||
        adminOf(resource.data.familyId)
      );

      allow delete: if signedIn() && (
        resource.data.targetUid == request.auth.uid
        || adminOf(resource.data.familyId)
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
